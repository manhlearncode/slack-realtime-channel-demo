# Dùng cho npm start khi PostgreSQL chạy trên máy hoặc docker compose up -d db.
DATABASE_URL=postgresql://chatdemo:chatdemo_local@127.0.0.1:5432/chatdemo
PORTS=3001,3002
HOST=127.0.0.1
# Docker Compose publish hai cổng 3001/3002. Dùng 127.0.0.1 cho demo một máy.
# Đổi APP_BIND_IP thành 0.0.0.0 khi demo LAN theo docs/LAN_DEMO.md.
APP_BIND_IP=127.0.0.1
